root = true
shell_variant = bash

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.html]
max_line_length = 10000

[*.{json,yml,yaml,toml}]
indent_size = 2

[*.json]
max_line_length = 10

[*.{js,jsx,ts,tsx}]
max_line_length = 200
indent_size = 2
